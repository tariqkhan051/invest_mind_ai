# Application
APP_NAME=InvestMind AI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# API
API_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local dev; PostgreSQL for production)
DATABASE_URL=sqlite:///./data/invest_mind_ai.db
# DATABASE_URL=postgresql+psycopg://investmind:changeme@localhost:5432/invest_mind_ai

# Security (MVP local auth — change in production)
SECRET_KEY=change-me-to-a-long-random-secret-key

# Scheduler
SCHEDULER_ENABLED=true

# Shariah compliance default
SHARIAH_MODE=true

# Monthly investment default (PKR)
DEFAULT_MONTHLY_INVESTMENT=50000
